                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div id='LeaderboardPanelMobile'>
                <div id='LeaderboardHeaderMobile'>
                    <h2> Leaderboard </h2>
                </div>
                <div id='LeaderboardListMobile'>
                    
                </div>
            </div>
            <div id='WeddingItineraryPanelMobile'>
                <div id='WeddingItineraryHeaderMobile'>
                    <h2> Wedding Itinerary </h2>
                </div>
                <div id='WeddingItineraryListMobile'>

                </div>
            </div>
            <div id='TablesPanelMobile'>
                <div id='TablesHeaderMobile'>
                    <h2> Tables </h2>
                </div>
                <div id='TablesNamesMobile'>

                </div>
                <div id='GuestsOnTable'>
                    <img onclick="closeDisplayGuestOnTableMobile()" src="~/images/close.png" alt="">
                </div>
            </div>
            <div id='LiveFeedPanelMobile'>
                <form id='UploadPostFormMobile' action="">
                    <img onclick="CloseUploadFormMobile()" id="CloseUploadPostMobile" src="~/images/close.png" alt="">
                    <h2> Upload a new Post </h2>
                    <label for="PostDescription"> Post Description </label>
                    <textarea id='PostDescription' name="Description" id=""></textarea>
                    <label id='UploadImage' for="PostImageMobile">
                        Upload Image
                        <input id='PostImageMobile' name='PhotoFeed' accept="images/*" type="file">
                    </label>
                    <button id='SendFormMobile' type="submit"> Post it! </button>
                </form>
                <img onclick="OpenUploadFormMobile()" id='AddPostMobile' src="~/images/Add.png" alt="">
                <div id='LiveFeedHeaderMobile'>
                    <h2 id='LiveFeedWelcomeMobile'> Welcome, @ViewBag.UserName </h2>
                </div>
                <div id='LiveFeedPostsMobile'>

                </div>
            </div>
        </div>

    </div>

    <script src="/js/Index.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        async function loadDataChart(){
            [rawExpenses, rawVendors, rawBudget] = await Promise.allSettled([
                fetch('/api/Expenses').then(response => response.json()),
                fetch('/api/Vendors').then(response => response.json()),
                fetch('/api/Budget').then(response => response.json())
            ])

            const char = document.getElementById('Chart')
            console.log(char)

            let totalExpense = 0

            let expenses = []

            let vendors = []

            const maxBudget = rawBudget.value[0].maxBudget

            rawExpenses.value.forEach(e => {
                expenses.push(e.expensePrice)
                totalExpense += e.expensePrice
            })

            rawVendors.value.forEach(v => {
                if (v.hired == 1){
                    vendors.push(v.vendorPrice)
                    totalExpense += v.vendorPrice
                }
            })

            const budget = maxBudget - totalExpense

            console.log(totalExpense, budget, maxBudget, expenses, vendors)

            new Chart(char, {
            type: 'doughnut',
            data: {
                labels: [],
                datasets: [{
                    data: [totalExpense, budget],
                    borderWidth: 1,
                    backgroundColor: ['#c69f29', '#ffc000']
                }]
            },
            options: {
                plugins: {
                    tooltip: {
                        backgroundColor: 'Yellow',
                        callbacks: {
                            label: function(context) {
                                return Intl.NumberFormat('en-US', {
                                    style: "currency",
                                    currency: "USD"
                                }).format(context.raw);
                            }
                        }
                    }
                }
            }
        })
        }

        loadDataChart()

    </script>
</body>
</html>